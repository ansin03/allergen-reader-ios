{
  "expo": {
    "name": "EatSurely AI",
    "slug": "eatsurely-ai",
    "version": "1.0.0",
    "description": "Food Allergen Scanner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b5e20"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eatsurely.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "EatSurely AI needs camera access to scan food ingredient labels.",
        "NSPhotoLibraryUsageDescription": "EatSurely AI needs photo access to analyze food ingredient labels from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "EatSurely needs camera access to scan food labels."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EatSurely needs photo access to analyse food labels."
        }
      ],
      "expo-secure-store"
    ]
  }
}
